# Copy this file to .env (gitignored) and fill in real values before
# running `npm run seed`. Never commit the real .env file.

# The admin's sign-in email — this is what they type on the admin portal
# login screen, not a username@fineaid.app synthetic address like regular
# app users.
ADMIN_EMAIL=admin@example.com

# Temporary password for first sign-in only. The admin is forced to set
# their own password immediately after logging in with this one, so it
# just needs to be strong enough to survive the gap between running this
# script and that first login — at least 8 characters.
ADMIN_PASSWORD=change-me-now

# Optional: path to a service account key JSON file, if you don't want to
# save one as ./serviceAccountKey.json next to this script.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
